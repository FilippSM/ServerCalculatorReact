    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prettier": "3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.2"
